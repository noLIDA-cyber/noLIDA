NODE_ENV=production
PORT=10000
API_VERSION=v1

# Supabase Postgres connection string
# Get this from Supabase Dashboard -> Project -> Settings -> Database -> Connection string -> "URI"
# Use the "Transaction" pooler URL (port 6543) with ?pgbouncer=true for serverless-friendly pooling
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT (Render auto-generates these on first deploy; only override if you want to set them yourself)
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Your deployed Vercel URL (e.g. https://nolida.vercel.app)
FRONTEND_URL=https://nolida.vercel.app
APP_URL=https://nolida.vercel.app
CORS_ORIGIN=https://nolida.vercel.app

# Password hashing
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Local file storage (Render persistent disk; will not work on Vercel)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nolida.com

# Twilio SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=
